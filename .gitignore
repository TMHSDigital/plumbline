# User data and run artifacts. Never commit these.
# Everything inside is the user's own labeled data. The negation keeps the
# directory itself in the repo so a fresh clone matches what the README
# describes; the glob still ignores every file and subdirectory under it.
datasets/private/*
!datasets/private/.gitkeep
results/
cache/
models/
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/

# Tooling caches
.pytest_cache/
# pytest scratch roots, if a runner ever resolves the temp root into the repo.
pytest-of-*/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Editors and OS
.idea/
.vscode/
.DS_Store
Thumbs.db
CLAUDE.md
